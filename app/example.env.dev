# COPY THIS FILE TO .env.dev AND UPDATE THAT FILE WITH YOUR LOCAL ENVIRONMENT VARIABLES
# ALL ENV vars must be prefixed with VITE_ to be available in the frontend code. See https://vitejs.dev/guide/env-and-mode.html#env-files
#
# NOTE: do NOT add VITE_PORT here. The dev server's published host port and
# container port come from the HOST environment (see BuildTools/README.md,
# "Environment variables"); a VITE_PORT set only in this file would change the
# container port but not the port mapping, making the dev server unreachable.


# Ensure that this url points to the backend API server
VITE_RUBY_API_URL=http://localhost:3005
